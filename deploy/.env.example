# BitNet Inference API Configuration
# These map directly to llama-server parameters.

BITNET_THREADS=4
BITNET_REPEAT_PENALTY=1.15
BITNET_TOP_P=0.9
BITNET_MIN_P=0.05
BITNET_TEMP=0.7

# Production Hardening Parameters
BITNET_API_KEY=your_secure_random_string_here
BITNET_CTX_SIZE=4096
BITNET_PARALLEL=2
