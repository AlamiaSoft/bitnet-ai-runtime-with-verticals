# ==============================================================================
# BitNet AI Runtime ? Environment Configuration
# ==============================================================================

# --- Runtime Settings ---
BITNET_RUNTIME_NAME="BitNet Local Runtime"
BITNET_ENV="development"
BITNET_DATA_DIR="./data"
BITNET_LOG_LEVEL="INFO"

# --- Server & Networking Settings ---
BITNET_HOST="127.0.0.1"
BITNET_PORT=8000
BITNET_ENABLE_DOCS=true

# --- Inference Provider & Local Model Settings ---
# Available providers: "bitnet", "llamacpp", "local_endpoint", "mock"
BITNET_DEFAULT_PROVIDER="bitnet"
BITNET_SERVER_URL="http://127.0.0.1:8080/v1"
BITNET_MODEL_NAME="/models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf"
BITNET_MODEL_PATH="./models/bitnet_b1_58-3B.gguf"
BITNET_TEMPERATURE=0.2
BITNET_MAX_TOKENS=1024
BITNET_CONTEXT_WINDOW=4096
BITNET_THREADS=4

# --- Local Endpoint / Adapter Settings (Ollama / LM Studio) ---
BITNET_LOCAL_ENDPOINT_URL="http://127.0.0.1:11434/v1"
BITNET_LOCAL_MODEL_NAME="llama3.2:1b"
BITNET_API_KEY=""

# --- Memory & Vector Storage ---
BITNET_DB_PATH="./data/memory.db"
BITNET_VECTOR_DIM=128
BITNET_CHUNK_SIZE=500
BITNET_CHUNK_OVERLAP=50
BITNET_SIMILARITY_THRESHOLD=0.0

# --- Agent & Execution Policy ---
BITNET_MAX_ITERATIONS=10
BITNET_TIMEOUT_SECONDS=120
BITNET_ENABLE_SHELL=true
BITNET_ENABLE_BROWSER=true
BITNET_ENABLE_CRON=true
BITNET_WORKING_DIR="./workspace"
